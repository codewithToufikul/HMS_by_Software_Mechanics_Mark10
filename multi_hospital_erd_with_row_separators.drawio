        <mxCell id="p3_n22" parent="1" style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fontSize=11;fontColor=#334155;spacingLeft=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#0F766E;dashed=1;" value="NURSE AND STAFF WORKFLOW (teal outlines): users &gt; hospital_users &gt; user_roles &gt; roles (dashboard_type nurse / general_staff). hospital_users &lt;- employees &lt;- nurses &gt; visit_nurse_assignments &gt; patient_visits &gt; patient_vital_signs, nursing_notes. employees &gt; tasks, employee_departments; notifications &gt; hospital_users. Nothing in this path depends on doctors." vertex="1">
          <mxGeometry height="60" width="1500" x="40" y="1320" as="geometry" />
        </mxCell>
